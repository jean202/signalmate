# ─── Database ─────────────────────────────────────────────
# USE_DB=false runs without PostgreSQL and stores demo data in local JSON files.
# Production should use USE_DB=true with a managed PostgreSQL/pgvector database.
DATABASE_URL="postgresql://signalmate:signalmate_local@localhost:5433/signalmate?schema=public"
USE_DB=false

# ─── Feature Flags ────────────────────────────────────────
# Enables rule-based vs hybrid evaluation metadata on analysis creation.
EVAL_MODE=false

# ─── Logging ──────────────────────────────────────────────
# Valid values: debug, info, warn, error, silent.
# Default: info in development, warn in production, silent in tests.
LOG_LEVEL=

# ─── Anthropic LLM + Vision ───────────────────────────────
# Empty ANTHROPIC_API_KEY gracefully falls back to rule-based analysis,
# but OCR upload and LLM-enhanced analysis require it.
ANTHROPIC_API_KEY=

# Optional. If omitted, production defaults to claude-sonnet-4-6 and
# development defaults to claude-haiku-4-5-20251001.
ANTHROPIC_MODEL=

# Optional. OCR upload uses this model; if omitted, it falls back to ANTHROPIC_MODEL/default.
# Haiku is a good low-latency default for screenshot extraction.
ANTHROPIC_VISION_MODEL=claude-haiku-4-5-20251001

# Stage timeout budgets in milliseconds.
ANTHROPIC_SIGNAL_TIMEOUT_MS=20000
ANTHROPIC_RECOMMENDATION_TIMEOUT_MS=25000
ANTHROPIC_AGENT_ITERATION_TIMEOUT_MS=8000
ANTHROPIC_RETRY_BASE_DELAY_MS=500

# Extended/adaptive thinking controls. Valid values: off, enabled, adaptive.
# Stage-specific values override ANTHROPIC_THINKING_MODE.
ANTHROPIC_THINKING_MODE=
ANTHROPIC_THINKING_SIGNAL_ENHANCER=off
ANTHROPIC_THINKING_RECOMMENDATION=enabled
ANTHROPIC_THINKING_AGENT=enabled

# ─── OpenAI Embeddings (Phase 3 RAG) ──────────────────────
# Optional. Enables pgvector similarity search and background embedding writes.
OPENAI_API_KEY=

# ─── Toss Payments ────────────────────────────────────────
# Server returns TOSS_CLIENT_KEY from /api/v1/payments/checkout; it is not NEXT_PUBLIC.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ─── Auth (next-auth v5) ──────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Kakao OAuth (https://developers.kakao.com)
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=

# Google OAuth (https://console.cloud.google.com)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
